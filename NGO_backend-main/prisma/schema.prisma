// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Define your own models here and run `prisma generate` to deploy changes.
enum Role {
  USER
  NGO_ADMIN
  SUPER_ADMIN
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum EmergencyStatus {
  PENDING
  ACCEPTED
  RESOLVED
}

enum AdoptionStatus {
  AVAILABLE
  ADOPTED
  PENDING
}

model User {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  username     String
  email        String        @unique
  password     String
  role         Role          @default(USER)
  refreshToken String?
  donations    Donation[]
  emergencies  Emergency[]
  adoptions    AdoptionRequest[]
  ngoAdmins    NGOAdmin[]
  rescues       Rescue[]
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?     // @softDelete  <-- This is just a comment/marker.

  // Indexes
  @@index([email, role])
}

model NGO {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String
  website         String
  contactEmail    String
  phone           String
  address         String
  logo            String?       // CDN URL (e.g., S3/Cloudinary)
  socialMedia     Json?         // { facebook: string, instagram: string }
  subscriptionId  String?
  subscription    Subscription? 
  status          NGOStatus     @default(PENDING)
  admins          NGOAdmin[]
  donations       Donation[]
  animals         Animal[]
  emergencies     EmergencyResponse[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Indexes
  @@index([name, status])
}

enum NGOStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

model SubscriptionPlan {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  name        String      // "Basic", "Pro", "Enterprise"
  price       Float
  duration    Int         // Months
  features    String[]    // ["Unlimited Donations", "Priority Support"]
  subscriptions Subscription[]
  createdAt   DateTime    @default(now())
}

model Subscription {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  ngo             NGO           @relation(fields: [ngoId], references: [id])
  ngoId           String        @unique@db.ObjectId
  plan            SubscriptionPlan @relation(fields: [planId], references: [id])
  planId          String        @unique@db.ObjectId
  startDate       DateTime
  endDate         DateTime
  status          PaymentStatus @default(PENDING)
  razorpayOrderId String?
  createdAt       DateTime      @default(now())
}

model Donation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @unique
  paymentId String   // No longer optional - will use "pending" as temp value
  amount    Int
  currency  String
  donorName String
  email     String?
  purpose   String   @default("General")
  comment   String?
  status    String   @default("PENDING") // PENDING, COMPLETED, FAILED
  receipt   String
  paidAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional relation to User if the donor was logged in
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?  @db.ObjectId
  
  // Optional relation to NGO if donation is for a specific NGO
  ngo       NGO?     @relation(fields: [ngoId], references: [id])
  ngoId     String?  @db.ObjectId
}


model Emergency {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  user        User               @relation(fields: [userId], references: [id])
  userId      String             @db.ObjectId
  location    Json               // { lat: number, lng: number }
  description Json               // Changed from String to Json to handle structured data
  status      EmergencyStatus    @default(PENDING)
  responses   EmergencyResponse[]
  createdAt   DateTime           @default(now())
}

model EmergencyResponse {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  emergency   Emergency   @relation(fields: [emergencyId], references: [id])
  emergencyId String      @db.ObjectId
  ngo         NGO         @relation(fields: [ngoId], references: [id])
  ngoId       String      @db.ObjectId
  status      ResponseStatus @default(PENDING)
  acceptedAt  DateTime?
  updatedAt   DateTime    @updatedAt
  notes       String?     // Optional notes about the response
  respondedBy String?     @db.ObjectId // ID of the NGO admin who responded

  @@index([emergencyId, ngoId])
}

enum ResponseStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Animal {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  ngo         NGO                @relation(fields: [ngoId], references: [id])
  ngoId       String             @db.ObjectId
  name        String
  species     AnimalSpecies
  age         Int
  description String
  photos      String[]           // CDN URLs
  status      AdoptionStatus     @default(AVAILABLE)
  requests    AdoptionRequest[]
  createdAt   DateTime           @default(now())
}

enum AnimalSpecies {
  DOG
  CAT
  COW
  BIRD
  OTHER
}

model AdoptionRequest {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  user        User        @relation(fields: [userId], references: [id])
  userId      String      @db.ObjectId
  animal      Animal      @relation(fields: [animalId], references: [id])
  animalId    String      @db.ObjectId
  status      RequestStatus @default(PENDING)
  requestedAt DateTime    @default(now())
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model WebhookEvent {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  type      String      // "payment.success", "subscription.created"
  payload   Json
  createdAt DateTime    @default(now())
}

model NGOAdmin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  ngo       NGO      @relation(fields: [ngoId], references: [id])
  ngoId     String   @db.ObjectId
  assignedAt DateTime @default(now())

  @@unique([userId, ngoId])
}

model Rescue {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  location    String
  description String
  status      RescueStatus @default(PENDING)
  animalType  String
  priority    RescuePriority @default(MEDIUM)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String   @db.ObjectId
  createdByUser User   @relation(fields: [createdBy], references: [id])
  assignedTo  String?  @db.ObjectId
  completedAt DateTime?

  @@index([status, priority])
  @@index([createdBy])
}

enum RescueStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RescuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}